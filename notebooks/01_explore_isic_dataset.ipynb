{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# 01 - Explore ISIC Dataset\n",
        "\n",
        "Khảo sát bộ dữ liệu ISIC trước khi thực hiện preprocessing và huấn luyện mô hình.\n",
        "\n",
        "Nội dung:\n",
        "- Kiểm tra cấu trúc dataset.\n",
        "- Thống kê số lượng ảnh và mask.\n",
        "- Kiểm tra kích thước ảnh.\n",
        "- Kiểm tra sự tương ứng giữa image và mask.\n",
        "- Kiểm tra giá trị pixel của mask.\n",
        "- Hiển thị ảnh mẫu và mask."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from pathlib import Path\n",
        "from collections import Counter\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from PIL import Image"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Notebook nằm trong thư mục notebooks/\n",
        "PROJECT_ROOT = Path(\"..\")\n",
        "\n",
        "IMAGE_TRAIN_DIR = PROJECT_ROOT / \"data\" / \"images\" / \"train\"\n",
        "IMAGE_TEST_DIR = PROJECT_ROOT / \"data\" / \"images\" / \"test\"\n        "\n",
        "MASK_TRAIN_DIR = PROJECT_ROOT / \"data\" / \"masks\" / \"train\"\n",
        "MASK_TEST_DIR = PROJECT_ROOT / \"data\" / \"masks\" / \"test\"\n",
        "\n",
        "print(\"===== DATASET PATHS =====\")\n",
        "print(\"Train images:\", IMAGE_TRAIN_DIR.resolve())\n",
        "print(\"Test images :\", IMAGE_TEST_DIR.resolve())\n",
        "print(\"Train masks :\", MASK_TRAIN_DIR.resolve())\n",
        "print(\"Test masks  :\", MASK_TEST_DIR.resolve())"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "directories = {\n",
        "    \"Train Images\": IMAGE_TRAIN_DIR,\n",
        "    \"Test Images\": IMAGE_TEST_DIR,\n",
        "    \"Train Masks\": MASK_TRAIN_DIR,\n",
        "    \"Test Masks\": MASK_TEST_DIR\n",
        "}\n",
        "\n",
        "print(\"===== CHECK DIRECTORIES =====\")\n",
        "\n",
        "for name, directory in directories.items():\n",
        "    if directory.exists():\n",
        "        print(f\"[OK] {name}: {directory}\")\n",
        "    else:\n",
        "        print(f\"[MISSING] {name}: {directory}\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "IMAGE_EXTENSIONS = {\".jpg\", \".jpeg\", \".png\"}\n",
        "\n",
        "\n",
        "def get_image_files(directory):\n",
        "    \"\"\"Lấy danh sách file ảnh trong thư mục.\"\"\"\n",
        "    if not directory.exists():\n",
        "        return []\n",
        "\n",
        "    return sorted([\n",
        "        file\n",
        "        for file in directory.iterdir()\n",
        "        if file.is_file()\n",
        "        and file.suffix.lower() in IMAGE_EXTENSIONS\n",
        "    ])\n",
        "\n",
        "\n",
        "train_images = get_image_files(IMAGE_TRAIN_DIR)\n",
        "test_images = get_image_files(IMAGE_TEST_DIR)\n",
        "train_masks = get_image_files(MASK_TRAIN_DIR)\n",
        "test_masks = get_image_files(MASK_TEST_DIR)\n",
        "\n",
        "\n",
        "print(\"===== DATASET STATISTICS =====\")\n",
        "print(f\"Train images : {len(train_images)}\")\n",
        "print(f\"Test images  : {len(test_images)}\")\n",
        "print(f\"Train masks  : {len(train_masks)}\")\n",
        "print(f\"Test masks   : {len(test_masks)}\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "def count_extensions(files):\n",
        "    return Counter(\n",
        "        file.suffix.lower()\n",
        "        for file in files\n",
        "    )\n",
        "\n",
        "\n",
        "print(\"===== IMAGE FORMATS =====\")\n",
        "\n",
        "print(\"Train:\")\n",
        "for ext, count in count_extensions(train_images).items():\n",
        "    print(f\"  {ext}: {count}\")\n",
        "\n",
        "print(\"\\nTest:\")\n",
        "for ext, count in count_extensions(test_images).items():\n",
        "    print(f\"  {ext}: {count}\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "def check_image_mask_pairs(image_files, mask_dir):\n",
        "    \"\"\"Kiểm tra mỗi image có mask tương ứng hay không.\"\"\"\n",
        "    matched = []\n",
        "    missing = []\n",
        "\n",
        "    for image_path in image_files:\n",
        "        mask_path = mask_dir / f\"{image_path.stem}.png\"\n",
        "\n",
        "        if mask_path.exists():\n",
        "            matched.append(image_path)\n",
        "        else:\n",
        "            missing.append(image_path)\n",
        "\n",
        "    return matched, missing\n",
        "\n",
        "\n",
        "train_matched, train_missing = check_image_mask_pairs(\n",
        "    train_images,\n",
        "    MASK_TRAIN_DIR\n",
        ")\n",
        "\n",
        "test_matched, test_missing = check_image_mask_pairs(\n",
        "    test_images,\n",
        "    MASK_TEST_DIR\n",
        ")\n",
        "\n",
        "\n",
        "print(\"===== IMAGE - MASK PAIRS =====\")\n",
        "print(f\"Train matched : {len(train_matched)}\")\n",
        "print(f\"Train missing : {len(train_missing)}\")\n",
        "print(f\"Test matched  : {len(test_matched)}\")\n",
        "print(f\"Test missing  : {len(test_missing)}\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "if train_missing:\n",
        "    print(\"Train images không có mask:\")\n",
        "    for file in train_missing[:10]:\n",
        "        print(\" \", file.name)\n",
        "\n",
        "if test_missing:\n",
        "    print(\"\\nTest images không có mask:\")\n",
        "    for file in test_missing[:10]:\n",
        "        print(\" \", file.name)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "def get_image_info(files, max_samples=100):\n",
        "    \"\"\"Lấy thông tin kích thước ảnh.\"\"\"\n",
        "    records = []\n",
        "\n",
        "    for file in files[:max_samples]:\n",
        "        try:\n",
        "            with Image.open(file) as image:\n",
        "                records.append({\n",
        "                    \"filename\": file.name,\n",
        "                    \"width\": image.width,\n",
        "                    \"height\": image.height,\n",
        "                    \"mode\": image.mode\n",
        "                })\n",
        "        except Exception as error:\n",
        "            print(f\"[ERROR] {file.name}: {error}\")\n",
        "\n",
        "    return pd.DataFrame(records)\n",
        "\n",
        "\n",
        "train_info = get_image_info(train_images)\n",
        "train_info.head()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "print(\"===== IMAGE SIZE =====\")\n",
        "\n",
        "if not train_info.empty:\n",
        "    print(\n",
        "        \"Số kích thước khác nhau:\",\n",
        "        train_info[[\"width\", \"height\"]].drop_duplicates().shape[0]\n",
        "    )\n",
        "\n",
        "    print(\"\\nCác kích thước phổ biến:\")\n",
        "    print(\n",
        "        train_info[[\"width\", \"height\"]]\n",
        "        .value_counts()\n",
        "        .head(10)\n",
        "    )"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "print(\"===== IMAGE MODE =====\")\n",
        "\n",
        "if not train_info.empty:\n",
        "    print(train_info[\"mode\"].value_counts())"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "if train_images:\n",
        "    sample_image_path = train_images[0]\n",
        "\n",
        "    image = Image.open(sample_image_path).convert(\"RGB\")\n",
        "\n",
        "    print(\"File:\", sample_image_path.name)\n",
        "    print(\"Size:\", image.size)\n",
        "    print(\"Mode:\", image.mode)\n",
        "\n",
        "    plt.figure(figsize=(6, 6))\n",
        "    plt.imshow(image)\n",
        "    plt.title(\"Sample ISIC Image\")\n",
        "    plt.axis(\"off\")\n",
        "    plt.show()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "if train_images:\n",
        "    image_path = train_images[0]\n",
        "    mask_path = MASK_TRAIN_DIR / f\"{image_path.stem}.png\"\n",
        "\n",
        "    if mask_path.exists():\n",
        "        mask = Image.open(mask_path).convert(\"L\")\n",
        "        mask_array = np.array(mask)\n",
        "\n",
        "        print(\"Mask:\", mask_path.name)\n",
        "        print(\"Mask size:\", mask.size)\n",
        "        print(\"Unique pixel values:\", np.unique(mask_array))\n",
        "\n",
        "        plt.figure(figsize=(6, 6))\n",
        "        plt.imshow(mask_array, cmap=\"gray\")\n",
        "        plt.title(\"Ground Truth Mask\")\n",
        "        plt.axis(\"off\")\n",
        "        plt.show()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "def check_mask(mask_path):\n",
        "    \"\"\"Kiểm tra vùng lesion trong mask.\"\"\"\n",
        "    mask = np.array(\n",
        "        Image.open(mask_path).convert(\"L\")\n",
        "    )\n",
        "\n",
        "    lesion_pixels = np.sum(mask > 0)\n",
        "    total_pixels = mask.size\n",
        "\n",
        "    lesion_ratio = (\n",
        "        lesion_pixels / total_pixels\n",
        "        if total_pixels > 0\n",
        "        else 0\n",
        "    )\n",
        "\n",
        "    return lesion_pixels, lesion_ratio\n",
        "\n",
        "\n",
        "if train_matched:\n",
        "    mask_path = MASK_TRAIN_DIR / f\"{train_matched[0].stem}.png\"\n",
        "\n",
        "    lesion_pixels, lesion_ratio = check_mask(mask_path)\n",
        "\n",
        "    print(\"===== MASK ANALYSIS =====\")\n",
        "    print(\"Lesion pixels:\", lesion_pixels)\n",
        "    print(f\"Lesion ratio : {lesion_ratio:.4%}\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "if train_matched:\n",
        "    image_path = train_matched[0]\n",
        "    mask_path = MASK_TRAIN_DIR / f\"{image_path.stem}.png\"\n",
        "\n",
        "    image = np.array(\n",
        "        Image.open(image_path).convert(\"RGB\")\n",
        "    )\n",
        "\n",
        "    mask = np.array(\n",
        "        Image.open(mask_path).convert(\"L\")\n",
        "    )\n",
        "\n",
        "    plt.figure(figsize=(8, 8))\n",
        "    plt.imshow(image)\n",
        "    plt.imshow(mask, cmap=\"Reds\", alpha=0.4)\n",
        "    plt.title(\"ISIC Image + Ground Truth Mask\")\n",
        "    plt.axis(\"off\")\n",
        "    plt.show()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "num_samples = min(6, len(train_images))\n",
        "\n",
        "if num_samples > 0:\n",
        "    fig, axes = plt.subplots(\n",
        "        2,\n",
        "        3,\n",
        "        figsize=(12, 8)\n",
        "    )\n",
        "\n",
        "    axes = axes.flatten()\n",
        "\n",
        "    for i in range(6):\n",
        "        axes[i].axis(\"off\")\n",
        "\n",
        "        if i >= num_samples:\n",
        "            continue\n",
        "\n",
        "        image_path = train_images[i]\n",
        "        image = Image.open(image_path).convert(\"RGB\")\n        \n",
        "        axes[i].imshow(image)\n",
        "        axes[i].set_title(image_path.stem)\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.show()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "print(\"=\" * 60)\n",
        "print(\"ISIC DATASET EXPLORATION SUMMARY\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "print(f\"Train images : {len(train_images)}\")\n",
        "print(f\"Train masks  : {len(train_masks)}\")\n",
        "print(f\"Matched      : {len(train_matched)}\")\n",
        "print(f\"Missing mask : {len(train_missing)}\")\n",
        "\n",
        "print(f\"\\nTest images  : {len(test_images)}\")\n",
        "print(f\"Test masks   : {len(test_masks)}\")\n",
        "print(f\"Matched      : {len(test_matched)}\")\n",
        "print(f\"Missing mask : {len(test_missing)}\")\n",
        "\n",
        "if not train_info.empty:\n",
        "    print(\n",
        "        f\"\\nSample image size: \"\n",
        "        f\"{train_info.iloc[0]['width']} x \"\n",
        "        f\"{train_info.iloc[0]['height']}\"\n",
        "    )\n",
        "\n",
        "print(\"=\" * 60)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Kết luận\n",
        "\n",
        "Dataset ISIC đã được kiểm tra về số lượng ảnh, mask, định dạng, kích thước và sự tương ứng giữa image và mask.\n",
        "\n",
        "Các dữ liệu hợp lệ sẽ được sử dụng cho bước preprocessing, data augmentation, Faster R-CNN detection và U-Net segmentation."
      ]
    }
  ],
